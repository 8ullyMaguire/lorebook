# Rust
/target
**/*.rs.bk
# A per-crate target dir, created when a test or script runs `cargo` from
# inside crates/<name> rather than the workspace root. `/target` above is
# anchored, so it does not cover these -- and the Calibre interop script
# creates a 184 MB one at crates/lorebook-calibre/target.
crates/*/target

# Tauri / SvelteKit (not yet scaffolded, but ignore early)
/src-tauri/target
/ui/node_modules
/ui/.svelte-kit
/ui/build
/ui/dist

# Local Calibre libraries. `lib/` is what the interop test creates when run from
# the repo root; a real user library must never be committed.
/lib/
*.db-wal
*.db-shm

# The one committed database is the test fixture, deliberately.
!fixtures/
!fixtures/*.db

# Tauri generated ACL schemas - regenerated by tauri-build on every build.
src-tauri/gen/
